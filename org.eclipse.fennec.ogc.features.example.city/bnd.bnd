Bundle-Name: Fennec OGC Features Example — Dim Stadt Model
Bundle-Description: Demo model: the generated town Dim Stadt (boundary, districts, land use, streets, \
 buildings, places), annotated as OGC API Features \
 collections and mapped to Fennec persistence with single table inheritance.

src: src-gen,src
-library: enableEMF

-generate: \
	model/city.ecore; \
		generate=fennecEMF; \
		ecore=model/city.ecore; \
		output=src-gen

# If this is not done with an instruction namespace, bnd would think you like
# to take full control over whats exported and imported and will ignore @Export
-includeresource.model: model=model

-buildpath: \
	org.geojson.model;version=latest
