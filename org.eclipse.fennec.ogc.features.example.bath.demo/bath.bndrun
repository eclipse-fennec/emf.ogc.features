# The leisure pool demo server: OGC API Features on http://localhost:8080/ogc,
# the map viewer on http://localhost:8080/ogc/viewer/, data in H2 under generated/h2.
#   ./gradlew :org.eclipse.fennec.ogc.features.example.bath.demo:run.bath

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.ogc.features.example.bath.demo',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.runtime',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.viewer',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.source',\
	bnd.identity;id='org.eclipse.fennec.ogc.features.geo',\
	bnd.identity;id='org.eclipse.fennec.codec.geojson',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.metadata',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository.jpa',\
	bnd.identity;id='org.eclipse.persistence.asm',\
	bnd.identity;id='org.eclipse.persistence.jpa.jpql',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.apache.felix.gogo.command'

-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runfw: org.apache.felix.framework
-runee: JavaSE-21

-runproperties: \
	org.osgi.service.http.port=8080,\
	gosh.args=--nointeractive,\
	configurator.initial=${fileuri;${.}/config/bath-demo.json}
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.22.0,2.22.1)',\
	com.h2database;version='[2.3.232,2.3.233)',\
	jakarta.persistence-api;version='[3.2.0,3.2.1)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.http.jetty12;version='[1.0.34,1.0.35)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.daanse.jdbc.datasource.common;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.datasource.h2;version='[0.0.1,0.0.2)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.geojson;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.command.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.eobject.registry;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.metadata;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.expression.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.ogc.features.api;version=snapshot,\
	org.eclipse.fennec.ogc.features.example.bath;version=snapshot,\
	org.eclipse.fennec.ogc.features.example.bath.demo;version=snapshot,\
	org.eclipse.fennec.ogc.features.geo;version=snapshot,\
	org.eclipse.fennec.ogc.features.runtime;version=snapshot,\
	org.eclipse.fennec.ogc.features.source;version=snapshot,\
	org.eclipse.fennec.ogc.features.viewer;version=snapshot,\
	org.eclipse.fennec.persistence;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.capabilities;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.eclipselink;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.orm;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.query;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.repository;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.repository.jpa;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.query.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.stream.model;version='[0.1.0,0.1.1)',\
	org.eclipse.parsson.jakarta.json;version='[1.1.7,1.1.8)',\
	org.eclipse.persistence.asm;version='[9.9.0,9.9.1)',\
	org.eclipse.persistence.core;version='[4.0.9,4.0.10)',\
	org.eclipse.persistence.jpa;version='[4.0.9,4.0.10)',\
	org.eclipse.persistence.jpa.jpql;version='[4.0.9,4.0.10)',\
	org.geojson.model;version='[0.0.1,0.0.2)',\
	org.locationtech.jts.jts-core;version='[1.20.0,1.20.1)',\
	org.objectweb.asm;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.commons;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree.analysis;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.util;version='[9.9.1,9.9.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)',\
	tools.jackson.core.jackson-core;version='[3.2.2,3.2.3)',\
	tools.jackson.core.jackson-databind;version='[3.2.2,3.2.3)'