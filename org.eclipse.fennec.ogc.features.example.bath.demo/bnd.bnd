Bundle-Name: Fennec OGC Features Example — Leisure Pool Demo
Bundle-Description: Demo data of a fictional leisure pool and the loader putting it into a \
 Fennec persistence repository, plus the launch configuration of the demo server.

-library: enableEMF

-includeresource.data: data/bath.geojson=data/bath.geojson

-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.geojson.model;version=latest,\
	org.eclipse.fennec.persistence.repository;version=latest,\
	org.eclipse.fennec.persistence.query;version=latest,\
	org.eclipse.fennec.query.model;version=latest,\
	org.eclipse.fennec.expression.model;version=latest,\
	org.eclipse.fennec.ogc.features.api;version=snapshot,\
	org.eclipse.fennec.ogc.features.geo;version=snapshot,\
	org.eclipse.fennec.ogc.features.example.bath;version=snapshot

-testpath: \
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	org.eclipse.fennec.codec.geojson;version=latest,\
	org.locationtech.jts.jts-core;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest
